// Prisma schema — Next.js + MySQL
// Документация: https://pris.ly/d/prisma-schema
//
// База переведена с SQLite на MySQL: на шаред-хостинге домашняя папка
// лежит на сетевой ФС, где файловые блокировки SQLite не работают и любой
// запрос зависает. MySQL 8 на хостинге решает это и выдерживает
// одновременные регистрации.

generator client {
  // Клиент без нативного Rust-движка. Ключевая строка — engineType = "client":
  // она заставляет Prisma сгенерировать клиент на WASM-компиляторе запросов
  // (@prisma/client/runtime/client) вместо нативного движка
  // (@prisma/client/runtime/library). Нативный движок линкуется с системным
  // OpenSSL 1.0.2 (CentOS 7 на хостинге) и падает при коннекте к MySQL.
  // WASM-компилятор + JS-драйвер mariadb работают через OpenSSL 3.x,
  // встроенный в Node 22, и не падают.
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "nodejs"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Роли пользователей хранятся строкой ("USER" или "ADMIN"):
// валидация значения — на уровне приложения (исторически из-за SQLite).

// Учётная запись — данные для авторизации и роль
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("USER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Поле явного согласия на обработку персональных данных (152-ФЗ)
  consentGiven  Boolean  @default(false)
  consentAt     DateTime?

  // «Мягкое удаление» (архив). Если archivedAt задан — учётка в архиве:
  // скрыта из списка/статистики и не может войти. Полное удаление —
  // отдельным действием из архива. См. src/lib/archive.ts.
  archivedAt    DateTime?
  archivedBy    String?

  profile        Profile?
  application    Application?
  supportMessages SupportMessage[]
}

// Сообщение чата поддержки между участником и администратором.
model SupportMessage {
  id          String   @id @default(cuid())
  userId      String   // тред принадлежит этому участнику
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAdmin   Boolean  @default(false) // true — ответ администратора
  body        String   @db.Text // текст сообщения может быть длинным
  readByAdmin Boolean  @default(false)
  readByUser  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Заявка на участие в Программе (подробная анкета с лендинга).
// Одна заявка на пользователя. Поля соответствуют форме регистрации.
model Application {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Сведения об участнике
  fio           String   // ФИО полностью
  vuz           String   // Высшее учебное заведение
  city          String   // Город
  department    String   // Подразделение (институт/факультет)
  position      String   // Должность
  phone         String   // Контактный телефон
  email         String   // Контактный e-mail

  // Удостоверение о повышении квалификации (обязательный вопрос)
  wantsCertificate Boolean

  // Участник отметил, что заполнил анкету ИППК
  ippkFilled    Boolean  @default(false)

  // Проживание (обязательный вопрос)
  residency     String   // "local" | "nonresident"
  hotel         String?  // выбранный отель (для иногородних)
  roomCategory  String?  // категория номера (только гостиница НГУ)
  stayDates     String?  // даты пребывания
  roommatePrefs String?  @db.Text // пожелания по подселению

  // Секция (основная обязательна)
  sectionPrimary   Int
  sectionSecondary Int?

  // Формат участия
  participation String   // listener|discussant|brief|report
  abstract      String?  @db.Text // тезисы (могут быть длинными)

  // Культурная программа (обязательный выбор)
  cultural      String   // evolution|museum|books|dome|none

  // Лекции (опционально) — JSON-строка с выбором по лекциям
  lectures      String?  @db.Text
  comments      String?  @db.Text

  consent       Boolean  @default(false)
  agree         Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Персональные данные участника (по ТЗ).
// Эти поля заполняются и редактируются в личном кабинете.
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName      String   // ФИО полностью
  university    String   // Наименование вуза
  city          String   // Город
  department    String   // Подразделение (институт/факультет)
  position      String   // Должность
  phone         String   // Контактный телефон
  contactEmail  String   // Контактный e-mail (может отличаться от логина)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
