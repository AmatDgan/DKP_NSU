# Скопируйте этот файл в .env и заполните значения
# Database (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth v5
# Сгенерировать секрет: openssl rand -base64 32
AUTH_SECRET="замените_на_случайную_строку"
AUTH_URL="http://localhost:3000"

# Параметры первого админа (создаётся при выполнении `npm run db:seed`).
# ОБЯЗАТЕЛЬНЫ. Скрипт seed откажется работать с пустыми, примерными
# или слабыми значениями. Пароль — не короче 12 символов.
# Сгенерировать пароль: openssl rand -base64 18
SEED_ADMIN_EMAIL="org@nsu.ru"
SEED_ADMIN_PASSWORD="замените_на_надёжный_пароль_не_короче_12_символов"
SEED_ADMIN_NAME="Администратор"
