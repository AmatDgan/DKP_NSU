# ─────────────────────────────────────────────────────────────────────────────
#  ШАБЛОН переменных окружения для ПРОДАКШЕНА (reg.ru / ISPmanager).
#
#  На сервере создайте файл  .env  (без «.example») в корне проекта и впишите
#  туда РЕАЛЬНЫЕ значения. Этот файл-шаблон секретов не содержит и его можно
#  держать в репозитории; сам .env в git НЕ попадает (он в .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# База данных — MySQL на хостинге (SQLite больше НЕ используется: на сетевой
# файловой системе хостинга он зависал). Подключение идёт через unix-сокет —
# параметр ?socket=... ОБЯЗАТЕЛЕН, без него драйвер пойдёт по TCP и не подключится.
# Подставьте имя пользователя БД, пароль и имя базы из панели хостинга.
# Путь к сокету у Sprinthost обычно /var/lib/mysql/mysql.sock (уточните в панели).
DATABASE_URL="mysql://ПОЛЬЗОВАТЕЛЬ_БД:ПАРОЛЬ_БД@localhost/ИМЯ_БАЗЫ?socket=/var/lib/mysql/mysql.sock"

# Секрет для подписи сессий (cookie входа). ОБЯЗАТЕЛЬНО задайте СВОЙ.
# Сгенерировать на сервере:  openssl rand -base64 32
AUTH_SECRET="ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ_СЕКРЕТ"

# Полный адрес сайта по HTTPS (с вашим доменом, без слэша на конце).
AUTH_URL="https://ВАШ-ДОМЕН"

# Учётка администратора, которую создаст команда `npm run db:seed`.
# E-mail — ваш рабочий, пароль — НАДЁЖНЫЙ, не короче 12 символов.
# Сгенерировать пароль:  openssl rand -base64 18
SEED_ADMIN_EMAIL="org@ВАШ-ДОМЕН"
SEED_ADMIN_PASSWORD="ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ"
SEED_ADMIN_NAME="Администратор"
